{
  "name": "nestgen",
  "version": "1.0.0",
  "description": "CLI pour générer entités et repositories NestJS",
  "main": "dist/index.js",
  "bin": {
    "nestgen": "dist/index.js"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "ts-node src/index.ts",
    "copy:templates": "robocopy templates dist\\templates /E"
  },
  "keywords": [
    "nestjs",
    "cli",
    "generator"
  ],
  "author": "Ton Nom",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.1",
    "ejs": "^3.1.10",
    "inquirer": "^12.10.0",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.9.1",
    "@types/pluralize": "^0.0.33",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
